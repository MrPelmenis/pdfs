<policy>
  <rule>
    <xpath>//document</xpath>
    <property>document=yes</property>
  </rule>
  <rule>
    <xpath>//document/id</xpath>
    <property>id=yes</property>
    <property>index=text&amp;xml</property>
    <property>list=yes</property>
  </rule>
  <rule>
    <xpath>//document/openalex_id</xpath>
    <property>index=text&amp;xml</property>
    <property>list=yes</property>
  </rule>
  <rule>
    <xpath>//document/file</xpath>
    <property>index=text&amp;xml</property>
    <property>weight=90-100</property>
    <property>list=yes</property>
  </rule>
  <rule>
    <xpath>//document/title</xpath>
    <property>index=text&amp;xml</property>
    <property>weight=90-100</property>
    <property>list=yes</property>
  </rule>
  <rule>
    <xpath>//document/date</xpath>
    <property>index=text&amp;xml</property>
    <property>index-numbers=int</property>
    <property>list=yes</property>
  </rule>
  <rule>
    <xpath>//document/doi_number</xpath>
    <property>index=text&amp;xml</property>
    <property>list=yes</property>
  </rule>
  <rule>
    <xpath>//document/cited_by_count</xpath>
    <property>index=no</property>
    <property>list=yes</property>
  </rule>
  <rule>
    <xpath>//document/img_preview_path</xpath>
    <property>index=no</property>
    <property>list=yes</property>
  </rule>
  <rule>
    <xpath>//document/stub_document</xpath>
    <property>index=xml</property>
    <property>list=yes</property>
  </rule>
  <rule>
    <xpath>//document/category_id</xpath>
    <property>index=text&amp;xml&amp;facet</property>
    <property>list=yes</property>
  </rule>


  <rule>
    <xpath>//document/authors</xpath>
    <property>index=text&amp;xml</property>
    <property>weight=70-80</property>
    <property>list=yes</property>
  </rule>
  <rule>
    <xpath>//document/authors/author</xpath>
    <property>index=text&amp;xml</property>
    <property>weight=70-80</property>
    <property>list=yes</property>
  </rule>

  <rule>
    <xpath>//document/abstract</xpath>
    <property>index=text&amp;xml</property>
    <property>weight=70-80</property>
    <property>list=highlight</property>
  </rule>


  <rule>
    <xpath>//document/topics</xpath>
    <property>index=text&amp;xml</property>
  </rule>
  <rule>
    <xpath>//document/topics/topic</xpath>
    <property>index=text&amp;xml&amp;facet</property>
    <property>weight=70-80</property>
    <property>list=yes</property>
  </rule>


  <rule>
    <xpath>//document/concepts</xpath>
    <property>index=text&amp;xml</property>
  </rule>
  <rule>
    <xpath>//document/concepts/concept</xpath>
    <property>index=text&amp;xml</property>
    <property>weight=60-70</property>
    <property>list=yes</property>
  </rule>


  <rule>
    <xpath>//document/keywords</xpath>
    <property>index=text&amp;xml</property>
  </rule>
  <rule>
    <xpath>//document/keywords/keyword</xpath>
    <property>index=text&amp;xml</property>
    <property>weight=75-85</property>
    <property>list=yes</property>
  </rule>


  <rule>
    <xpath>//document/keywords_extracted</xpath>
    <property>index=text&amp;xml</property>
  </rule>
  <rule>
    <xpath>//document/keywords_extracted/keyword</xpath>
    <property>index=text&amp;xml</property>
    <property>weight=70-80</property>
    <property>list=yes</property>
  </rule>


  <rule>
    <xpath>//document/sections</xpath>
    <property>index=text&amp;xml</property>
  </rule>
  <rule>
    <xpath>//document/sections/section</xpath>
    <property>index=text&amp;xml</property>
    <property>weight=55-65</property>
    <property>list=highlight</property>
  </rule>

  <rule>
    <xpath>//document/methods</xpath>
    <property>index=xml-text&amp;xml</property>
    <property>list=no</property>
  </rule>
  <rule>
    <xpath>//document/methods/method</xpath>
    <property>index=text&amp;xml</property>
    <property>weight=50-60</property>
    <property>list=no</property>
  </rule>
  <rule>
    <xpath>//document/methods/method/heading</xpath>
    <property>index=text&amp;xml</property>
    <property>weight=60-70</property>
    <property>list=no</property>
  </rule>
  <rule>
    <xpath>//document/methods/method/text</xpath>
    <property>index=text&amp;xml</property>
    <property>weight=50-60</property>
    <property>list=no</property>
  </rule>


  <rule>
    <xpath>//document/conclusions</xpath>
    <property>index=xml-text&amp;xml</property>
    <property>list=no</property>
  </rule>
  <rule>
    <xpath>//document/conclusions/conclusion</xpath>
    <property>index=text&amp;xml</property>
    <property>weight=50-60</property>
    <property>list=no</property>
  </rule>
  <rule>
    <xpath>//document/conclusions/conclusion/heading</xpath>
    <property>index=text&amp;xml</property>
    <property>weight=60-70</property>
    <property>list=no</property>
  </rule>
  <rule>
    <xpath>//document/conclusions/conclusion/text</xpath>
    <property>index=text&amp;xml</property>
    <property>weight=50-60</property>
    <property>list=no</property>
  </rule>



  <rule>
    <xpath>//document/figures</xpath>
    <property>index=text&amp;xml</property>
    <property>list=no</property>
  </rule>
  <rule>
    <xpath>//document/figures/figure</xpath>
    <property>index=text&amp;xml</property>
    <property>list=no</property>
  </rule>
  <rule>
    <xpath>//document/figures/figure/figure_label</xpath>
    <property>index=text&amp;xml</property>
    <property>weight=60-70</property>
    <property>list=yes</property>
  </rule>
  <rule>
    <xpath>//document/figures/figure/caption</xpath>
    <property>index=text&amp;xml</property>
    <property>weight=80-90</property>
    <property>list=highlight</property>
  </rule>
  <rule>
    <xpath>//document/figures/figure/page</xpath>
    <property>index=no</property>
    <property>list=no</property>
  </rule>


  <rule>
    <xpath>//document/tables</xpath>
    <property>index=no</property>
    <property>list=no</property>
  </rule>
  <rule>
    <xpath>//document/tables/table</xpath>
    <property>index=no</property>
    <property>list=no</property>
  </rule>
  <rule>
    <xpath>//document/tables/table/content</xpath>
    <property>index=no</property>
    <property>list=yes</property>
  </rule>
  <rule>
    <xpath>//document/tables/table/grid</xpath>
    <property>index=no</property>
    <property>list=yes</property>
  </rule>
  <rule>
    <xpath>//document/tables/table/grid/row</xpath>
    <property>index=no</property>
    <property>list=yes</property>
  </rule>
  <rule>
    <xpath>//document/tables/table</xpath>
    <property>index=text&amp;xml</property>
    <property>list=no</property>
  </rule>
  <rule>
    <xpath>//document/tables/table/caption</xpath>
    <property>index=text&amp;xml</property>
    <property>weight=50-60</property>
    <property>list=yes</property>
  </rule>
  <rule>
    <xpath>//document/tables/table/content</xpath>
    <property>index=no</property>
    <property>list=no</property>
  </rule>
  <rule>
    <xpath>//document/tables/table/page</xpath>
    <property>index=no</property>
    <property>list=no</property>
  </rule>
  <rule>
    <xpath>//document/tables/table/grid</xpath>
    <property>index=no</property>
    <property>list=no</property>
  </rule>
  <rule>
    <xpath>//document/tables/table/grid/row</xpath>
    <property>index=no</property>
    <property>list=no</property>
  </rule>


  <rule>
    <xpath>//document/full_text</xpath>
    <property>index=text&amp;xml</property>
    <property>weight=30-40</property>
    <property>stem-lang=en</property>
    <property>list=snippet</property>
  </rule>


  <rule>
    <xpath>//document/referenced_work_ids</xpath>
    <property>index=xml</property>
    <property>list=yes</property>
  </rule>
  <rule>
    <xpath>//document/referenced_work_ids/referenced_work_id</xpath>
    <property>index=text&amp;xml</property>
    <property>list=yes</property>
  </rule>
  <rule>
    <xpath>//document/related_work_ids</xpath>
    <property>index=xml</property>
    <property>list=yes</property>
  </rule>
  <rule>
    <xpath>//document/related_work_ids/related_work_id</xpath>
    <property>index=text&amp;xml</property>
    <property>list=yes</property>
  </rule>

</policy>
